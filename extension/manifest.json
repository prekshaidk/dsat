{
  "manifest_version": 3,
  "name": "DSAT Bank Guard",
  "version": "2.0",
  "description": "Blocks phishing bank websites and verifies genuine ones using the dynamic code hidden in the bank logo.",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": { "service_worker": "background.js" },
  "omnibox": { "keyword": "bank" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["dsat_extract.js", "content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "DSAT Bank Guard",
              "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
